# ===============================================================
# GABARIT .env.staging  (copier vers .env.staging sur le VPS, ne JAMAIS commiter la copie)
# Usage :
#   docker compose --env-file .env.staging -f docker-compose-staging.yml up -d --build
# ===============================================================

# --- Domaines ---
STAGING_DOMAIN=tarif.enclume-numerique.com
TRAEFIK_CERT_RESOLVER=myresolver

# --- BDD staging (DISTINCTE de la prod : identifiants différents) ---
STAGING_POSTGRES_DB=hscode_staging
STAGING_POSTGRES_USER=staging_user
STAGING_POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# --- Keycloak (PARTAGÉ avec la prod : mêmes valeurs que le .env de prod) ---
KEYCLOAK_EXTERNAL_URL=https://CHANGE_ME_KEYCLOAK_DOMAIN
KEYCLOAK_REALM=hscode-realm
KEYCLOAK_FRONTEND_CLIENT=frontend-client
KEYCLOAK_BACKEND_CLIENT=backend-client
KEYCLOAK_BACKEND_CLIENT_SECRET=CHANGE_ME

# --- RabbitMQ staging (mot de passe propre au staging) ---
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=CHANGE_ME

# --- IA : clés dédiées staging (projet OpenAI avec plafond de dépense bas) ---
AI_PROVIDER=openai
STAGING_OPENAI_API_KEY=
STAGING_ANTHROPIC_API_KEY=

# --- Paiement : clés de TEST Chargily uniquement (vide = paiement désactivé) ---
STAGING_CHARGILY_SECRET_KEY=
STAGING_CHARGILY_WEBHOOK_SECRET=

# --- Application ---
MARKET_VERSION=DZ
BETA_MODE=false
DEFAULT_PLAN_NAME=Essai gratuit
EMAIL_ADMIN_HSCODE=
