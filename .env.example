# ===============================================================
# EXEMPLE DE CONFIGURATION — BOX LOCALE ALGÉRIE (DZ)
# Copier vers .env sur le boîtier du client et adapter chaque secret.
# ===============================================================

PROJECT_NAME=box
IMAGE_TAG=latest
REGISTRY_PREFIX=ghcr.io/enclume-numerique/tci

# ---------------------------------------------------------------
# 1. DOMAINES LAN & CERTIFICAT HTTPS LET'S ENCRYPT (DNS-01)
#    Les enregistrements DNS pointent vers l'IP LAN de la Box (ex. 192.168.1.50)
#    Aucun port entrant n'est ouvert sur le routeur du client.
# ---------------------------------------------------------------
FRONTEND_DOMAIN=client1.box.enclume-numerique.com
KEYCLOAK_DOMAIN=auth.client1.box.enclume-numerique.com
ACME_EMAIL=infra@enclume-numerique.com
ACME_DNS_PROVIDER=cloudflare
CF_DNS_API_TOKEN=CHANGEZ_MOI_TOKEN_DNS_SCOPED_ZONE
ACME_DNS_DELAY=15

# ---------------------------------------------------------------
# 2. BASES DE DONNÉES POSTGRESQL LOCALES
# ---------------------------------------------------------------
POSTGRES_DB=hscode-app-db
POSTGRES_USER=muhend
POSTGRES_PASSWORD=CHANGEZ_MOI_FORT_APP_DB
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CHANGEZ_MOI_FORT_KC_DB

# ---------------------------------------------------------------
# 3. KEYCLOAK & RABBITMQ LOCAUX
# ---------------------------------------------------------------
KEYCLOAK_REALM=hscode-realm
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGEZ_MOI_ADMIN_KC
KEYCLOAK_FRONTEND_CLIENT=frontend-client
KEYCLOAK_BACKEND_CLIENT=backend-client
KEYCLOAK_BACKEND_CLIENT_SECRET=CHANGEZ_MOI_SECRET_KC
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=CHANGEZ_MOI_RABBITMQ

# ---------------------------------------------------------------
# 4. IA 100 % LOCALE (OLLAMA)
#    - Mac Mini M4 Pro (Ollama natif Metal) : http://host.docker.internal:11434
#    - Mini-PC Linux NVIDIA (--profile linux-gpu) : http://ollama:11434
# ---------------------------------------------------------------
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_NUM_CTX=16384
OLLAMA_KEEP_ALIVE=24h
OLLAMA_JSON_MODE=true
AI_HTTP_READ_TIMEOUT_MS=180000
AI_BATCH_LOCAL_MAX_REQUESTS=300
AI_BATCH_LOCAL_CONCURRENCY=1
AI_BATCH_LOCAL_LEVEL=POSITIONS10

# ---------------------------------------------------------------
# 5. BOOTSTRAP ORGANISATION CLIENTE & SMTP INTERNE
# ---------------------------------------------------------------
BOOTSTRAP_ENABLED=true
ORG_NAME=Entreprise Cliente Alger SARL
ORG_EMAIL=admin@entreprise-cliente.dz
ORG_PASSWORD=CHANGEZ_MOI_MOT_DE_PASSE_ORG
ORG_ADDRESS=Zone Industrielle Rouiba, Alger
ORG_PHONE=+21321000000
ORG_ACTIVITY_DOMAIN=Transit et Commerce International

# Coupé par défaut pour garantir 0 fuite d'email hors du LAN
SMTP_ENABLED=false

# ---------------------------------------------------------------
# 6. LICENCE ED25519 & HEARTBEAT MINIMAL (ZÉRO PII)
# ---------------------------------------------------------------
BOX_ID=box-client1-dz
LICENSE_PUBLIC_KEY=COLLEZ_CLE_PUBLIQUE_ED25519_BASE64
LICENSE_TOKEN=TCI1.COLLEZ_JETON_INITIAL_SIGNE
LICENSE_HEARTBEAT_URL=
LICENSE_HEARTBEAT_INTERVAL_MS=43200000
OFFLINE_GRACE_DAYS=30

# ---------------------------------------------------------------
# 7. SAUVEGARDES LOCALES & TUNNEL DE SUPPORT TEMPORAIRE
# ---------------------------------------------------------------
BACKUP_DIR=/var/backups/tci-box
BACKUP_RETENTION_DAYS=30
BACKUP_PASSPHRASE=
TAILSCALE_AUTHKEY=
