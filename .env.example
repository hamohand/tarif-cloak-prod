# ===============================================================
# GABARIT .env — TCI SaaS (DZ + UE)
# Copier vers .env (ne JAMAIS commiter .env) :
#   cp .env.example .env
# Démarrage :
#   docker compose up -d --build
# ===============================================================

# --- Projet & Domaine ---
PROJECT_NAME=tci
FRONTEND_DOMAIN=tarif.enclume-numerique.com
TRAEFIK_NETWORK=webproxy
TRAEFIK_CERT_RESOLVER=myresolver
MARKET_VERSION=DZ

# --- Base de données PostgreSQL ---
POSTGRES_DB=tci_db
POSTGRES_USER=tci_user
POSTGRES_PASSWORD=CHANGEZ_MOI_MOT_DE_PASSE_BDD
POSTGRES_PORT=5432

# --- Authentification Keycloak dédiée (conteneurs tci-keycloak & tci-keycloak-db) ---
KEYCLOAK_DOMAIN=auth.tarif.enclume-numerique.com
KEYCLOAK_EXTERNAL_URL=https://auth.tarif.enclume-numerique.com
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=tci-realm
KEYCLOAK_FRONTEND_CLIENT=frontend-client
KEYCLOAK_BACKEND_CLIENT=backend-client
KEYCLOAK_BACKEND_CLIENT_SECRET=backend-secret-modification-avec-keycloak-conseillee
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CHANGEZ_MOI_MOT_DE_PASSE_BDD_KEYCLOAK
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGEZ_MOI_MOT_DE_PASSE_ADMIN_KEYCLOAK

# --- RabbitMQ ---
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=CHANGEZ_MOI_MOT_DE_PASSE_RABBITMQ

# --- Intelligence Artificielle (Cloud) ---
# AI_PROVIDER : openai | anthropic | ollama
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PRICE_INPUT=0.40
OPENAI_PRICE_OUTPUT=1.60
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_PRICE_INPUT=3.00
ANTHROPIC_PRICE_OUTPUT=15.00

# --- Passerelles de Paiement (laisser vide = repli automatique sur paiement par virement / facture) ---
CHARGILY_SECRET_KEY=
CHARGILY_WEBHOOK_SECRET=
CHARGILY_API_URL=https://pay.chargily.net/test/api/v2
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Emails transactionnels & notifications devis (SMTP) ---
# (Pour capturer localement sans envoyer d'emails : lancer avec --profile mailpit et mettre SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_AUTH=false, SMTP_STARTTLS=false, SMTP_STARTTLS_REQUIRED=false)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_STARTTLS_REQUIRED=true
SMTP_FROM=noreply@enclume-numerique.com
SMTP_FROM_NAME=Enclume Numérique
EMAIL_ADMIN_HSCODE=

# --- Quotas visiteurs (déjà relevés par défaut sur la branche saas-conference pour le Wi-Fi partagé) ---
# GUEST_TRIAL_MAX_PER_IP_PER_DAY=25
# GUEST_TRIAL_GLOBAL_DAILY_LIMIT=300
# GUEST_DECODE_MAX_PER_IP_PER_DAY=50
# GUEST_DECODE_GLOBAL_DAILY_LIMIT=1000
# QUOTE_REQUESTS_PUBLIC_MAX_PER_IP_PER_DAY=50
# SEARCH_RATELIMIT_AVERAGE=15
# SEARCH_RATELIMIT_BURST=40
