# ===============================================================
# CONFIGURATION PRÊTE À L'EMPLOI — DZ-LOCALIZATION (ORDINATEUR LOCAL)
# ===============================================================
# Démarrage immédiat sur Windows / Mac / Linux :
#   1. Installer Ollama sur l'ordinateur et télécharger le modèle :
#      ollama pull qwen2.5:7b
#   2. Copier ce fichier vers .env :
#      - Windows (PowerShell) : Copy-Item .env.example .env
#      - Mac / Linux          : cp .env.example .env
#   3. Lancer l'application :
#      docker compose up -d --build
#   4. Ouvrir http://localhost:8088
#      Compte initial : admin@local.dz / AdminLocal2026!
# ===============================================================

PROJECT_NAME=tci-local
APP_EDITION=dz-localization

# ---------------------------------------------------------------
# 1. ACCÈS LOCAL SUR L'ORDINATEUR (ZÉRO DOMAINE NI CERTIFICAT)
# ---------------------------------------------------------------
BIND_ADDRESS=127.0.0.1
APP_PORT=8088
KEYCLOAK_PORT=8085
FRONTEND_URL=http://localhost:8088
KEYCLOAK_EXTERNAL_URL=http://localhost:8085
CORS_ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://localhost:4200

# ---------------------------------------------------------------
# 2. BASES DE DONNÉES POSTGRESQL LOCALES
#    (À personnaliser lors d'une livraison chez un client final)
# ---------------------------------------------------------------
POSTGRES_DB=hscode-app-db
POSTGRES_USER=muhend
POSTGRES_PASSWORD=LocalPostgresDz2026!
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=LocalKeycloakDbDz2026!

# ---------------------------------------------------------------
# 3. KEYCLOAK & RABBITMQ LOCAUX
#    KEYCLOAK_BACKEND_CLIENT_SECRET correspond à keycloak/realm-export.json
# ---------------------------------------------------------------
KEYCLOAK_REALM=hscode-realm
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=LocalKeycloakAdmin2026!
KEYCLOAK_FRONTEND_CLIENT=frontend-client
KEYCLOAK_BACKEND_CLIENT=backend-client
KEYCLOAK_BACKEND_CLIENT_SECRET=backend-secret-modification-avec-keycloak-conseillee
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=LocalRabbitMqDz2026!

# ---------------------------------------------------------------
# 4. IA 100 % LOCALE SUR L'ORDINATEUR (OLLAMA)
#    - Windows / Mac (Docker Desktop + Ollama natif) : http://host.docker.internal:11434
#    - Modèle léger par défaut : qwen2.5:7b (ou qwen2.5:14b si GPU >= 12 Go / Mac 24 Go+)
# ---------------------------------------------------------------
BOX_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=16384
OLLAMA_KEEP_ALIVE=24h
OLLAMA_JSON_MODE=true
AI_HTTP_READ_TIMEOUT_MS=180000
AI_BATCH_LOCAL_MAX_REQUESTS=300
AI_BATCH_LOCAL_CONCURRENCY=1
AI_BATCH_LOCAL_LEVEL=POSITIONS10

# ---------------------------------------------------------------
# 5. COMPTE ORGANISATION CRÉÉ AUTOMATIQUEMENT AU 1ER DÉMARRAGE
# ---------------------------------------------------------------
BOOTSTRAP_ENABLED=true
ORG_NAME=Entreprise Locale DZ
ORG_EMAIL=admin@local.dz
ORG_PASSWORD=AdminLocal2026!
ORG_ADDRESS=Alger, Algérie
ORG_PHONE=+21321000000
ORG_ACTIVITY_DOMAIN=Transit et Commerce International

# Coupé par défaut : aucun email ne sort de l'ordinateur
SMTP_ENABLED=false

# ---------------------------------------------------------------
# 6. LICENCE ED25519 DE DÉMONSTRATION LOCALE (VALIDE JUSQU'EN 2030)
#    Pour livrer chez un client réel, générez votre propre paire de clés
#    avec : java scripts/GenerateLicense.java --gen-keys
# ---------------------------------------------------------------
BOX_ID=box-local-dz
LICENSE_PUBLIC_KEY=MCowBQYDK2VwAyEAUDscHKOh0aetNUIVtgMBxnO8/M7pInDiFsU9PjOAiLo=
LICENSE_TOKEN=TCI1..C7OElO_VEzG2EflFrVkMxwrkbWR56Hb6LZuqwUpUoEx1Zn2-0ew8e2mt8uRaFeypJ_oWtyZFhPt9SYdF92xqCg
LICENSE_HEARTBEAT_URL=
LICENSE_HEARTBEAT_INTERVAL_MS=43200000
OFFLINE_GRACE_DAYS=30

# ---------------------------------------------------------------
# 7. SAUVEGARDES LOCALES & TUNNEL DE SUPPORT OPTIONNEL
# ---------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_PASSPHRASE=
TAILSCALE_AUTHKEY=
